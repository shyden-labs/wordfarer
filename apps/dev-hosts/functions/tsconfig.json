{
  // The adapter's Function. Separate from ../tsconfig.json, which types the
  // host table's Node side: this one sees the Workers runtime (generated by
  // `wrangler types`) and nothing from Node or the DOM.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["*.ts", "../hosts.ts"]
}
