{
  // The adapter's Node side: the host table and the harness tests. The
  // Function itself is checked by functions/tsconfig.json, which sees the
  // Workers runtime (generated by `wrangler types`) and nothing from Node.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts", "test/**/*.ts"]
}
