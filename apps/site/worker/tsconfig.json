{
  // The site Worker. Separate from ../tsconfig.json, which types the Astro
  // pages: this one sees the Workers runtime (generated by `wrangler types`)
  // and nothing from the DOM.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["*.ts"]
}
