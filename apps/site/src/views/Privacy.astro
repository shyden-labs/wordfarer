---
import Base from '../layouts/Base.astro';
import { COPY } from '../copy';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = COPY[locale];
---

<Base locale={locale} page="privacy" title={copy.titles.privacy}>
  <h1>{copy.titles.privacy}</h1>
  <p>{copy.privacySoon}</p>
</Base>
