---
import Base from '../layouts/Base.astro';
import { COPY } from '../copy';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = COPY[locale];
---

<Base locale={locale} page="home" title={copy.titles.home}>
  <h1>Yawelo Idle</h1>
  <p>{copy.comingSoon}</p>
  <section id="launch-list">
    <p>{copy.launchListSoon}</p>
  </section>
</Base>
